{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servanda.dev/schema/hashing.schema.json",
  "title": "commitment_hash vectors (spec §3.2)",
  "type": "object",
  "allOf": [{ "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/banner" }],
  "required": ["description", "hashed_fields", "base_commitment_hash", "cases"],
  "properties": {
    "suite_version": {},
    "protocol_version": {},
    "spec_reference": {},
    "generated_by": {},
    "description": { "type": "string" },
    "hashed_fields": {
      "type": "array",
      "description": "§3.2: exactly these five fields, and no others, form the hash preimage.",
      "items": { "type": "string" },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "contains": { "enum": ["intent", "owner", "owed_to", "due", "created_at"] }
    },
    "base_commitment_hash": {
      "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/hex64"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "commitment",
          "hash_preimage",
          "hash_preimage_canonical",
          "commitment_hash",
          "same_hash_as_base"
        ],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "commitment": {
            "type": "object",
            "required": ["v", "type", "intent", "owner", "owed_to", "due", "created_at"],
            "properties": {
              "v": {
                "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/protocolVersion"
              },
              "type": { "const": "commitment" },
              "intent": { "type": "string", "maxLength": 500 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "source": {
                "enum": ["extracted", "explicit", "archaeology", "converted_expectation"]
              }
            }
          },
          "hash_preimage": {
            "type": "object",
            "required": ["intent", "owner", "owed_to", "due", "created_at"],
            "additionalProperties": false,
            "properties": {
              "intent": { "type": "string" },
              "owner": { "type": "string" },
              "owed_to": { "type": ["string", "null"] },
              "due": {
                "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/rfc3339OrNull"
              },
              "created_at": {
                "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/rfc3339"
              }
            }
          },
          "hash_preimage_canonical": { "type": "string" },
          "commitment_hash": {
            "$ref": "https://servanda.dev/schema/common.schema.json#/$defs/hex64"
          },
          "same_hash_as_base": { "type": "boolean" }
        }
      }
    }
  }
}
